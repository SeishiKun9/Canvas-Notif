DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
DISCORD_CHANNEL_ID=123456789012345678
CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_API_TOKEN=replace-with-your-canvas-access-token

# Leave empty to watch all active courses available to the Canvas account.
CANVAS_COURSE_IDS=

# Poll every five minutes; Canvas polling is kept at or above 30 seconds.
POLL_INTERVAL_SECONDS=300
DUE_REMINDER_HOURS=24,1
STATE_DB_PATH=canvas_notifier.sqlite3
LOG_LEVEL=INFO
